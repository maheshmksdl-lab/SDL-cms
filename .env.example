# ─────────────────────────────────────────────────────────────────────────────
# SDL CMS — copy to .env and fill in. Never commit .env.
# Secrets live HERE ONLY, never in the database (plan §4.12).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Your local PostgreSQL server (no Docker). Match the port to your install — 5432 by default.
# `pnpm setup:db` creates this role and database for you.
DATABASE_URI=postgres://sdl:sdl_local_dev@localhost:5432/sdl
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Optional: serve the admin under a sub-path, e.g. /cms. Leave blank for own origin.
NEXT_PUBLIC_CMS_BASE_PATH=

# ── Frontend coordination ────────────────────────────────────────────────────
# Where the public site lives. Used for revalidation webhooks and preview URLs.
WEB_URL=http://localhost:3000

# Shared secrets — the SAME values must be set in web/.env
REVALIDATE_SECRET=
PREVIEW_SECRET=

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated allowlists. No wildcard in production.
PAYLOAD_CORS_ORIGINS=http://localhost:3000
PAYLOAD_CSRF_ORIGINS=http://localhost:3000

# ── Media ────────────────────────────────────────────────────────────────────
# Local disk in development. Production MUST use object storage — local media is lost
# when the app moves to a new host or runs as more than one instance (plan §8.6).
SDL_MEDIA_DIR=media

# Set S3_BUCKET to switch the storage adapter on.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ── Email ────────────────────────────────────────────────────────────────────
# Fallback only — delivery accounts are configured in the admin panel.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@socialdnalabs.com
EMAIL_FROM_NAME=Social DNA Labs

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
